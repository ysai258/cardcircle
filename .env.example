# ---------------------------------------------------------------------------
# CardCircle environment
#
# Generate APP_MASTER_KEY with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Rotating APP_MASTER_KEY invalidates every stored phone number and expiry date
# (they become undecryptable) and breaks phone lookup. See docs/security.md.
# ---------------------------------------------------------------------------

# Postgres connection string.
# Local (docker compose up -d):
DATABASE_URL="postgresql://cardcircle:cardcircle_local_dev@localhost:55433/cardcircle"

# 32-byte base64 master key. All other keys are HKDF-derived from it.
# MUST be set to a unique value per environment. Never commit a real one.
APP_MASTER_KEY=""

# "development" | "production" | "test"
NODE_ENV="development"
